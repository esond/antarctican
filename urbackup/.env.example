BACKUP=/mnt/user/backup
APPDATA=/mnt/user/appdata

# User and Group IDs
PUID=99
PGID=100

# Timezone
TZ=Etc/UTC

# urbackup-exporter -- an UrBackup admin login (Settings -> Users) and the
# /metrics port scraped by the otel stack.
URBACKUP_SERVER_USERNAME=admin
URBACKUP_SERVER_PASSWORD=changeme
URBACKUP_METRICS_HOST_PORT=9554