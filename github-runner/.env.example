APPDATA=/mnt/user/appdata

# Timezone
TZ=Etc/UTC

# Runner scope: https://github.com/<org> or https://github.com/<owner>/<repo>.
# See README.md for the PAT permissions each scope needs.
RUNNER_URL=https://github.com/your-org
GITHUB_PAT=changeme
# Each runner appends its number, like antarctican-1.
RUNNER_NAME=antarctican
RUNNER_LABELS=antarctican
