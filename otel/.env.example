APPDATA=/mnt/user/appdata

# User and Group IDs
PUID=99
PGID=100

# Timezone
TZ=Etc/UTC

# OpenTelemetry Collector -- OTLP/HTTP intake. OpenClaw points at this port.
OTEL_COLLECTOR_HOST_PORT=4318

# VictoriaMetrics
VICTORIAMETRICS_HOST_PORT=8428
# Metrics retention; accepts d/w/y suffixes.
VICTORIAMETRICS_RETENTION=30d

# Grafana
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Scrape targets in other stacks, reached on the host's published ports. Keep
# these in sync with the corresponding stack's .env.
UNPACKERR_METRICS_PORT=5656
FLARESOLVERR_METRICS_PORT=8192
CLOUDFLARED_METRICS_PORT=20241
# CouchDB's /_node/_local/_prometheus needs admin auth -- same values as notes/.env.
COUCHDB_PORT=5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=Hunter2

# media/.env: QBITTORRENT_METRICS_HOST_PORT
QBITTORRENT_METRICS_PORT=8000
# media/.env: SCRAPARR_METRICS_HOST_PORT -- Sonarr, Radarr, Prowlarr and Seerr in one job.
SCRAPARR_METRICS_PORT=7100
# pihole/.env: PIHOLE_METRICS_HOST_PORT
PIHOLE_METRICS_PORT=9617
# urbackup/.env: URBACKUP_METRICS_HOST_PORT
URBACKUP_METRICS_PORT=9554
