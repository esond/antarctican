APPDATA=/mnt/user/appdata

# Timezone
TZ=Etc/UTC

# OpenClaw
OPENCLAW_HOST_PORT=18789
# Dedicated share for the agent workspace -- create it in Unraid first.
# Never point this at an existing share.
CLAW_WORKSPACE=/mnt/user/claw
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxx
DISCORD_BOT_TOKEN=discord-bot-token-here

# 1Password service account, scoped read-only to the agent's dedicated
# vault. Authenticates the bind-mounted op CLI.
OP_SERVICE_ACCOUNT_TOKEN=ops_changeme

# Browserless (agent browser tool) -- any long random string, e.g.
# `openssl rand -hex 24`. Gates CDP access to the Chromium sidecar.
BROWSERLESS_TOKEN=changeme

# Cloudflare Tunnel (public dashboard access via Cloudflare Zero Trust)
CLOUDFLARED_TUNNEL_TOKEN=cloudflare-tunnel-token-here
