DATA=/mnt/user/data
APPDATA=/mnt/user/appdata

# User and Group IDs
PUID=99
PGID=100

# Timezone
TZ=Etc/UTC

# qBittorrent VPN
QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_TORRENTING_PORT=6881
QBITTORRENT_VPN_USER=AzureDiamond+pmp
QBITTORRENT_VPN_PASS=hunter2
# WebUI login, used by qbittorrent-exporter. The container's own healthcheck
# doesn't need these (binhex bypasses auth on localhost), but the exporter
# connects over media-net and does.
QBITTORRENT_WEBUI_USER=admin
QBITTORRENT_WEBUI_PASSWORD=adminadmin
QBITTORRENT_METRICS_HOST_PORT=8081

# SWAG
SWAG_DNSPLUGIN=cloudflare
SWAG_EMAIL=hmccringleberry@psu.edu
SWAG_URL=example.com
SWAG_ONLY_SUBDOMAINS=false
SWAG_AUTORELOAD=true

# Sonarr
SONARR_UHD_HOST_PORT=8989
SONARR_HD_HOST_PORT=9898

# Radarr
RADARR_UHD_HOST_PORT=7878
RADARR_HD_HOST_PORT=8787

# Prowlarr
PROWLARR_HOST_PORT=9696

# Scraparr -- one /metrics endpoint for all three arrs. The API keys are each
# app's own key (Settings -> General), the same values UNPACKERR_* uses below.
SCRAPARR_METRICS_HOST_PORT=7100
SONARR_UHD_API_KEY="32-character-long-api-key-123456"
RADARR_UHD_API_KEY="32-character-long-api-key-123456"
PROWLARR_API_KEY="32-character-long-api-key-123456"

# FlareSolverr
FLARESOLVERR_LOG_LEVEL=info
FLARESOLVERR_HOST_PORT=8191
FLARESOLVERR_METRICS_HOST_PORT=8192

# Notifiarr
NOTIFIARR_HOST_PORT=5454
NOTIFIARR_HOSTNAME=antarctican

# Seerr (formerly Overseerr)
SEERR_LOG_LEVEL=info
SEERR_HOST_PORT=5055

# Unpackerr
UNPACKERR_LOG_FILE_PATH="/config/unpackerr.log"
UNPACKERR_METRICS_HOST_PORT=5656
UNPACKERR_SONARR_UHD_URL="http://sonarr-uhd:8989"
UNPACKERR_SONARR_UHD_API_KEY="32-character-long-api-key-123456"
UNPACKERR_RADARR_UHD_URL="http://radarr-uhd:7878"
UNPACKERR_RADARR_UHD_API_KEY="32-character-long-api-key-123456"